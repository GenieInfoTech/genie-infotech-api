APP_NAME="Genie InfoTech API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://api.genieinfo.tech

# Frontend URL (for CORS)
FRONTEND_URL=https://genieinfo.tech

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database (MySQL on cPanel)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=genie_api
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=s9623.fra1.stableserver.net
MAIL_PORT=465
MAIL_USERNAME=noreply@genieinfo.tech
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@genieinfo.tech"
MAIL_FROM_NAME="Genie InfoTech"

# Notification Recipients
NOTIFICATION_EMAILS="contact@genieinfo.tech,genie.projectmanager@gmail.com"

# Security
SANCTUM_STATEFUL_DOMAINS=genieinfo.tech,www.genieinfo.tech,dev.genieinfo.tech
SESSION_DOMAIN=.genieinfo.tech

# Rate Limiting
API_RATE_LIMIT=60
LOGIN_RATE_LIMIT=5

# Filament Admin
FILAMENT_PATH=admin
